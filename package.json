{
  "name": "arbeitszeiterfassung",
  "version": "3.15.6",
  "private": true,
  "type": "module",
  "description": "Zeiterfassung — statische PWA. Playwright-Regression-Skript für QA vor jedem Version-Bump.",
  "scripts": {
    "serve": "python3 -m http.server 8765",
    "qa": "node scripts/regression.mjs",
    "qa:headed": "HEADLESS=0 node scripts/regression.mjs",
    "qa:ci": "node scripts/regression.mjs",
    "qa:webkit": "ENGINE=webkit node scripts/regression.mjs",
    "qa:webkit:ci": "ENGINE=webkit node scripts/regression.mjs",
    "visual:test": "node scripts/visual-regression.mjs",
    "visual:update": "node scripts/visual-regression.mjs --update",
    "typecheck": "node scripts/typecheck.mjs",
    "screenshots": "node scripts/gen_screenshots.mjs",
    "bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check"
  },
  "devDependencies": {
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "5.4"
  }
}
